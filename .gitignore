# Dataset
Flowers_dataset/
**/Flowers_dataset/

# Intermediate training checkpoints
checkpoint_epoch_*.pth
**/checkpoint_epoch_*.pth

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter
.ipynb_checkpoints/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Normalize text files
* text=auto

# Source / documentation files use LF
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ipynb text eol=lf

# Windows scripts use CRLF
*.bat text eol=crlf

# Git LFS model files
*.pth filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text